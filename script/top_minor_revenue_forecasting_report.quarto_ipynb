{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "﻿---\n",
        "title: \"Top Minor Revenue Forecasting Report\"\n",
        "author: \"Syed Al-Helal Uddin\"\n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-depth: 2\n",
        "    number-sections: true\n",
        "    code-fold: true\n",
        "    theme: cosmo\n",
        "    page-layout: article\n",
        "execute:\n",
        "  echo: true\n",
        "  warning: false\n",
        "  message: false\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "# Purpose\n",
        "\n",
        "This report builds reproducible forecasting models for selected minor revenue GL codes. It reads the combined DAWN revenue history file, calculates minor revenue shares, creates historical interactive plots, runs time-series diagnostics, validates multiple forecasting approaches, and forecasts the next three fiscal years for each GL code.\n",
        "\n",
        "The workflow excludes `GL Number == 3290` from minor revenue because it should be treated as Major.\n",
        "\n",
        "# Setup"
      ],
      "id": "082a2f90"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Core data tools\n",
        "from collections import defaultdict\n",
        "from pathlib import Path\n",
        "import math\n",
        "import warnings\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Interactive plotting\n",
        "import plotly.graph_objects as go\n",
        "import plotly.express as px\n",
        "from plotly.subplots import make_subplots\n",
        "from IPython.display import HTML, Markdown, display\n",
        "\n",
        "# Statistical and forecasting tools\n",
        "from scipy.stats import jarque_bera\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "from statsmodels.stats.diagnostic import acorr_ljungbox\n",
        "from statsmodels.tsa.api import ExponentialSmoothing\n",
        "from statsmodels.tsa.arima.model import ARIMA\n",
        "from statsmodels.tsa.stattools import acf, adfuller, pacf\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "pd.options.display.float_format = \"{:,.3f}\".format"
      ],
      "id": "809fdb30",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Paths are written so the report can be rendered from either the project root or the script folder.\n",
        "PROJECT_ROOT = Path.cwd()\n",
        "if PROJECT_ROOT.name.lower() == \"script\":\n",
        "    PROJECT_ROOT = PROJECT_ROOT.parent\n",
        "\n",
        "DATA_PATH = PROJECT_ROOT / \"data\" / \"dawn_revenue_accounts_combined_history.csv\"\n",
        "RESULTS_DIR = PROJECT_ROOT / \"results\"\n",
        "RESULTS_DIR.mkdir(exist_ok=True)\n",
        "\n",
        "if not DATA_PATH.exists():\n",
        "    raise FileNotFoundError(f\"Could not find combined history CSV at: {DATA_PATH}\")\n",
        "\n",
        "DATA_PATH"
      ],
      "id": "ed913b31",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Step 1: Read Combined History Data"
      ],
      "id": "35e21925"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Read the DAWN combined history file.\n",
        "df = pd.read_csv(DATA_PATH)\n",
        "\n",
        "# Standardize key fields used throughout the report.\n",
        "df[\"Amount\"] = pd.to_numeric(df[\"Amount\"], errors=\"coerce\").fillna(0.0)\n",
        "df[\"GL Number\"] = df[\"GL Number\"].astype(str).str.strip()\n",
        "df[\"Type\"] = df[\"Type\"].astype(str).str.strip()\n",
        "df[\"fy\"] = df[\"fy\"].astype(str).str.strip()\n",
        "df[\"description\"] = df[\"description\"].astype(str).str.strip()\n",
        "df[\"Date\"] = pd.to_datetime(df[\"Date\"], errors=\"coerce\")\n",
        "\n",
        "# Keep only minor records and exclude GL 3290.\n",
        "minor_df = df[\n",
        "    df[\"Type\"].str.lower().eq(\"minor\")\n",
        "    & ~df[\"GL Number\"].eq(\"3290\")\n",
        "].copy()\n",
        "\n",
        "print(f\"All rows: {len(df):,}\")\n",
        "print(f\"Minor rows excluding GL 3290: {len(minor_df):,}\")\n",
        "print(f\"Rows with GL 3290 in minor_df: {(minor_df['GL Number'] == '3290').sum():,}\")"
      ],
      "id": "9d17da8c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Step 2: Top 15 GL Codes by Share of Total Minor Revenue"
      ],
      "id": "9ac7cd39"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Total minor revenue across the full history.\n",
        "total_minor_amount = minor_df[\"Amount\"].sum()\n",
        "\n",
        "minor_gl_share = (\n",
        "    minor_df.groupby([\"GL Number\", \"description\"], as_index=False)\n",
        "    .agg(\n",
        "        total_amount=(\"Amount\", \"sum\"),\n",
        "        transaction_count=(\"Amount\", \"size\"),\n",
        "    )\n",
        "    .assign(share_of_total_minor=lambda x: x[\"total_amount\"] / total_minor_amount)\n",
        "    .sort_values(\"share_of_total_minor\", ascending=False)\n",
        ")\n",
        "\n",
        "top_15_minor_gl_share = minor_gl_share.head(15).copy()\n",
        "\n",
        "# Save output so the table can be reused outside the report.\n",
        "minor_gl_share.to_csv(RESULTS_DIR / \"minor_gl_revenue_share_all_history.csv\", index=False)\n",
        "top_15_minor_gl_share.to_csv(RESULTS_DIR / \"top_15_minor_gl_revenue_share_all_history.csv\", index=False)\n",
        "\n",
        "top_15_minor_gl_share"
      ],
      "id": "97535f32",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig = px.bar(\n",
        "    top_15_minor_gl_share.sort_values(\"share_of_total_minor\"),\n",
        "    x=\"share_of_total_minor\",\n",
        "    y=\"GL Number\",\n",
        "    color=\"description\",\n",
        "    orientation=\"h\",\n",
        "    text=top_15_minor_gl_share.sort_values(\"share_of_total_minor\")[\"share_of_total_minor\"].map(lambda x: f\"{x:.2%}\"),\n",
        "    title=\"Top 15 Minor GL Codes by Share of Total Minor Revenue\",\n",
        "    labels={\"share_of_total_minor\": \"Share of Total Minor Revenue\", \"GL Number\": \"GL Number\"},\n",
        ")\n",
        "fig.update_layout(height=650, showlegend=False)\n",
        "fig.update_xaxes(tickformat=\".0%\")\n",
        "fig.show()"
      ],
      "id": "243f0c8e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Modeling Functions"
      ],
      "id": "0efc20df"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "TARGET_GL_CODES = [\n",
        "    \"3113\", \"3052\", \"3130\", \"3066\", \"3050\", \"3073\", \"3053\", \"3152\", \"3101\", \"3002\",\n",
        "    \"3003\", \"3004\", \"3005\", \"3114\", \"3047\", \"3044\", \"3043\", \"3042\", \"3276\", \"3075\",\n",
        "]\n",
        "\n",
        "FORECAST_HORIZON = 3\n",
        "HOLDOUT_SIZE = 3\n",
        "RANDOM_SEED = 42\n",
        "\n",
        "\n",
        "def make_annual_series(data, gl_code):\n",
        "    \"\"\"Aggregate one GL code to fiscal-year totals.\"\"\"\n",
        "    one_gl = data[data[\"GL Number\"].eq(str(gl_code))].copy()\n",
        "    annual = (\n",
        "        one_gl.groupby(\"fy\", as_index=False)\n",
        "        .agg(total_amount=(\"Amount\", \"sum\"), description=(\"description\", \"first\"))\n",
        "    )\n",
        "    annual = annual[annual[\"fy\"].str.match(r\"^\\d+$\", na=False)].copy()\n",
        "    annual[\"fy\"] = annual[\"fy\"].astype(int)\n",
        "    annual = annual.sort_values(\"fy\").reset_index(drop=True)\n",
        "    return annual\n",
        "\n",
        "\n",
        "def mape(actual, predicted):\n",
        "    \"\"\"Mean absolute percentage error, skipping zero actuals.\"\"\"\n",
        "    actual = np.asarray(actual, dtype=float)\n",
        "    predicted = np.asarray(predicted, dtype=float)\n",
        "    mask = actual != 0\n",
        "    if mask.sum() == 0:\n",
        "        return np.nan\n",
        "    return np.mean(np.abs((actual[mask] - predicted[mask]) / actual[mask]))\n",
        "\n",
        "\n",
        "def rmse(actual, predicted):\n",
        "    return math.sqrt(mean_squared_error(actual, predicted))\n",
        "\n",
        "\n",
        "def run_adf(values, label):\n",
        "    \"\"\"Run ADF unit-root test and return a tidy dictionary.\"\"\"\n",
        "    values = pd.Series(values).dropna()\n",
        "    if len(values) < 8 or values.nunique() <= 1:\n",
        "        return {\n",
        "            \"series\": label,\n",
        "            \"adf_statistic\": np.nan,\n",
        "            \"p_value\": np.nan,\n",
        "            \"used_lag\": np.nan,\n",
        "            \"n_obs\": len(values),\n",
        "            \"critical_1pct\": np.nan,\n",
        "            \"critical_5pct\": np.nan,\n",
        "            \"critical_10pct\": np.nan,\n",
        "            \"verdict\": \"Insufficient variation/sample\",\n",
        "        }\n",
        "    stat, p_value, used_lag, n_obs, critical, _ = adfuller(values, autolag=\"AIC\")\n",
        "    return {\n",
        "        \"series\": label,\n",
        "        \"adf_statistic\": stat,\n",
        "        \"p_value\": p_value,\n",
        "        \"used_lag\": used_lag,\n",
        "        \"n_obs\": n_obs,\n",
        "        \"critical_1pct\": critical[\"1%\"],\n",
        "        \"critical_5pct\": critical[\"5%\"],\n",
        "        \"critical_10pct\": critical[\"10%\"],\n",
        "        \"verdict\": \"Stationary\" if p_value <= 0.05 else \"Unit root not rejected\",\n",
        "    }\n",
        "\n",
        "\n",
        "def plot_acf_pacf_interactive(values, gl_code, description):\n",
        "    \"\"\"Create interactive ACF/PACF plots for level and first difference with confidence bands.\"\"\"\n",
        "    values = pd.Series(values).astype(float).reset_index(drop=True)\n",
        "    diff_values = values.diff().dropna().reset_index(drop=True)\n",
        "\n",
        "    max_level_lags = max(1, min(10, len(values) - 2))\n",
        "    max_diff_lags = max(1, min(10, len(diff_values) - 2))\n",
        "    max_level_pacf_lags = max(1, min(max_level_lags, len(values) // 2 - 1))\n",
        "    max_diff_pacf_lags = max(1, min(max_diff_lags, len(diff_values) // 2 - 1))\n",
        "\n",
        "    acf_level = acf(values, nlags=max_level_lags, fft=False)\n",
        "    pacf_level = pacf(values, nlags=max_level_pacf_lags, method=\"ywm\")\n",
        "    acf_diff = acf(diff_values, nlags=max_diff_lags, fft=False)\n",
        "    pacf_diff = pacf(diff_values, nlags=max_diff_pacf_lags, method=\"ywm\")\n",
        "    level_ci = 1.96 / np.sqrt(len(values))\n",
        "    diff_ci = 1.96 / np.sqrt(len(diff_values))\n",
        "\n",
        "    fig = make_subplots(\n",
        "        rows=2,\n",
        "        cols=2,\n",
        "        subplot_titles=(\"ACF: Level\", \"PACF: Level\", \"ACF: First Difference\", \"PACF: First Difference\"),\n",
        "    )\n",
        "    fig.add_bar(x=list(range(len(acf_level))), y=acf_level, row=1, col=1, name=\"ACF level\")\n",
        "    fig.add_bar(x=list(range(len(pacf_level))), y=pacf_level, row=1, col=2, name=\"PACF level\")\n",
        "    fig.add_bar(x=list(range(len(acf_diff))), y=acf_diff, row=2, col=1, name=\"ACF diff\")\n",
        "    fig.add_bar(x=list(range(len(pacf_diff))), y=pacf_diff, row=2, col=2, name=\"PACF diff\")\n",
        "\n",
        "    # Approximate 95% confidence bands for correlation diagnostics.\n",
        "    for row, ci in [(1, level_ci), (2, diff_ci)]:\n",
        "        for col in [1, 2]:\n",
        "            fig.add_hline(y=ci, line_dash=\"dash\", line_color=\"firebrick\", row=row, col=col)\n",
        "            fig.add_hline(y=-ci, line_dash=\"dash\", line_color=\"firebrick\", row=row, col=col)\n",
        "    fig.update_layout(\n",
        "        title=f\"GL {gl_code} - {description}: ACF and PACF Diagnostics\",\n",
        "        height=700,\n",
        "        showlegend=False,\n",
        "    )\n",
        "    fig.update_xaxes(title_text=\"Lag\")\n",
        "    fig.update_yaxes(title_text=\"Correlation\")\n",
        "    return fig\n",
        "\n",
        "\n",
        "def select_d(unit_root_table):\n",
        "    \"\"\"Choose differencing order from ADF results.\"\"\"\n",
        "    level_p = unit_root_table.loc[unit_root_table[\"series\"].eq(\"Level\"), \"p_value\"].iloc[0]\n",
        "    diff_p = unit_root_table.loc[unit_root_table[\"series\"].eq(\"First difference\"), \"p_value\"].iloc[0]\n",
        "    if pd.notna(level_p) and level_p <= 0.05:\n",
        "        return 0\n",
        "    if pd.notna(diff_p) and diff_p <= 0.05:\n",
        "        return 1\n",
        "    return 2\n",
        "\n",
        "\n",
        "def find_arima_order(values, d, max_p=3, max_q=3):\n",
        "    \"\"\"Grid-search ARIMA p and q by AIC.\"\"\"\n",
        "    records = []\n",
        "    for p in range(max_p + 1):\n",
        "        for q in range(max_q + 1):\n",
        "            if p == 0 and d == 0 and q == 0:\n",
        "                continue\n",
        "            order = (p, d, q)\n",
        "            try:\n",
        "                model = ARIMA(values, order=order)\n",
        "                result = model.fit()\n",
        "                records.append({\n",
        "                    \"order\": order,\n",
        "                    \"aic\": result.aic,\n",
        "                    \"bic\": result.bic,\n",
        "                    \"hqic\": result.hqic,\n",
        "                    \"converged\": result.mle_retvals.get(\"converged\", None),\n",
        "                })\n",
        "            except Exception as exc:\n",
        "                records.append({\"order\": order, \"aic\": np.nan, \"bic\": np.nan, \"hqic\": np.nan, \"converged\": False})\n",
        "    order_table = pd.DataFrame(records).dropna(subset=[\"aic\"]).sort_values(\"aic\").reset_index(drop=True)\n",
        "    best_order = tuple(order_table.loc[0, \"order\"]) if len(order_table) else (1, d, 0)\n",
        "    return best_order, order_table\n",
        "\n",
        "\n",
        "def forecast_linear(train_years, train_values, future_years):\n",
        "    model = LinearRegression()\n",
        "    model.fit(np.asarray(train_years).reshape(-1, 1), train_values)\n",
        "    return model.predict(np.asarray(future_years).reshape(-1, 1))\n",
        "\n",
        "\n",
        "def forecast_holt(train_values, periods):\n",
        "    model = ExponentialSmoothing(train_values, trend=\"add\", seasonal=None, initialization_method=\"estimated\")\n",
        "    result = model.fit(optimized=True)\n",
        "    return np.asarray(result.forecast(periods))\n",
        "\n",
        "\n",
        "def forecast_monte_carlo(train_values, periods, simulations=5000, seed=RANDOM_SEED):\n",
        "    \"\"\"Monte Carlo forecast using historical one-year changes as the shock distribution.\"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    diffs = np.diff(train_values)\n",
        "    if len(diffs) == 0:\n",
        "        return np.repeat(train_values[-1], periods)\n",
        "    simulated_paths = np.zeros((simulations, periods))\n",
        "    for s in range(simulations):\n",
        "        value = train_values[-1]\n",
        "        for h in range(periods):\n",
        "            value = value + rng.choice(diffs)\n",
        "            simulated_paths[s, h] = value\n",
        "    return simulated_paths.mean(axis=0)\n",
        "\n",
        "\n",
        "def forecast_arima(train_values, periods, order):\n",
        "    model = ARIMA(train_values, order=order)\n",
        "    result = model.fit()\n",
        "    return np.asarray(result.forecast(steps=periods)), result\n",
        "\n",
        "\n",
        "def forecast_ml(train_years, train_values, future_years, lag=3):\n",
        "    \"\"\"Random forest with FY and lagged revenue features.\"\"\"\n",
        "    train_values = list(train_values)\n",
        "    train_years = list(train_years)\n",
        "    if len(train_values) <= lag:\n",
        "        return forecast_linear(train_years, train_values, future_years)\n",
        "\n",
        "    X, y = [], []\n",
        "    for i in range(lag, len(train_values)):\n",
        "        X.append([train_years[i], train_values[i - 1], train_values[i - 2], train_values[i - 3]])\n",
        "        y.append(train_values[i])\n",
        "\n",
        "    model = RandomForestRegressor(n_estimators=500, min_samples_leaf=2, random_state=RANDOM_SEED)\n",
        "    model.fit(X, y)\n",
        "\n",
        "    history = train_values.copy()\n",
        "    predictions = []\n",
        "    for year in future_years:\n",
        "        pred = float(model.predict([[year, history[-1], history[-2], history[-3]]])[0])\n",
        "        predictions.append(pred)\n",
        "        history.append(pred)\n",
        "    return np.asarray(predictions)\n",
        "\n",
        "\n",
        "def validate_models(years, values, order):\n",
        "    \"\"\"Validate candidate models on the last HOLDOUT_SIZE observations.\"\"\"\n",
        "    years = list(years)\n",
        "    values = np.asarray(values, dtype=float)\n",
        "    holdout = min(HOLDOUT_SIZE, max(1, len(values) // 4))\n",
        "    train_years, test_years = years[:-holdout], years[-holdout:]\n",
        "    train_values, test_values = values[:-holdout], values[-holdout:]\n",
        "\n",
        "    candidates = {}\n",
        "    candidates[\"Linear regression\"] = forecast_linear(train_years, train_values, test_years)\n",
        "    candidates[\"Exponential smoothing - Holt\"] = forecast_holt(train_values, holdout)\n",
        "    candidates[\"Monte Carlo\"] = forecast_monte_carlo(train_values, holdout)\n",
        "    candidates[\"ARIMA/SARIMA\"] = forecast_arima(train_values, holdout, order)[0]\n",
        "    candidates[\"Machine learning - Random Forest\"] = forecast_ml(train_years, train_values, test_years)\n",
        "\n",
        "    rows = []\n",
        "    for model_name, prediction in candidates.items():\n",
        "        rows.append({\n",
        "            \"model\": model_name,\n",
        "            \"mae\": mean_absolute_error(test_values, prediction),\n",
        "            \"rmse\": rmse(test_values, prediction),\n",
        "            \"mape\": mape(test_values, prediction),\n",
        "        })\n",
        "    return pd.DataFrame(rows).sort_values(\"mae\").reset_index(drop=True)\n",
        "\n",
        "\n",
        "def forecast_all_models(years, values, order, horizon=FORECAST_HORIZON):\n",
        "    \"\"\"Fit models on all available history and forecast future fiscal years.\"\"\"\n",
        "    years = list(years)\n",
        "    values = np.asarray(values, dtype=float)\n",
        "    future_years = [years[-1] + step for step in range(1, horizon + 1)]\n",
        "\n",
        "    forecasts = {\n",
        "        \"Linear regression\": forecast_linear(years, values, future_years),\n",
        "        \"Exponential smoothing - Holt\": forecast_holt(values, horizon),\n",
        "        \"Monte Carlo\": forecast_monte_carlo(values, horizon),\n",
        "        \"ARIMA/SARIMA\": forecast_arima(values, horizon, order)[0],\n",
        "        \"Machine learning - Random Forest\": forecast_ml(years, values, future_years),\n",
        "    }\n",
        "\n",
        "    rows = []\n",
        "    for model_name, predicted_values in forecasts.items():\n",
        "        for fy, predicted in zip(future_years, predicted_values):\n",
        "            rows.append({\"model\": model_name, \"fy\": fy, \"forecast_amount\": predicted})\n",
        "    return pd.DataFrame(rows)"
      ],
      "id": "d3448d29",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Steps 3 and 4: GL-by-GL Historical Plots, Diagnostics, Models, Validation, and Forecasts\n",
        "\n",
        "This section is organized one GL code at a time. For each GL code, the report shows the historical series first, then ACF/PACF diagnostics with confidence intervals, unit-root tests, ARIMA lag-order search, model results, residual tests, forecast values, validation results, and forecast plots."
      ],
      "id": "9145728b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "annual_series_by_gl = {}\n",
        "for gl_code in TARGET_GL_CODES:\n",
        "    annual = make_annual_series(minor_df, gl_code)\n",
        "    annual_series_by_gl[gl_code] = annual\n",
        "\n",
        "missing_codes = [gl for gl, annual in annual_series_by_gl.items() if annual.empty]\n",
        "if missing_codes:\n",
        "    print(\"No minor revenue history found for:\", missing_codes)"
      ],
      "id": "63041e19",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "all_unit_root_tests = []\n",
        "all_order_tables = []\n",
        "all_residual_tests = []\n",
        "all_validation_tables = []\n",
        "all_forecasts = []\n",
        "all_best_model_forecasts = []\n",
        "all_linear_model_results = []"
      ],
      "id": "59252e46",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "for gl_code, annual in annual_series_by_gl.items():\n",
        "    if annual.empty or len(annual) < 8:\n",
        "        print(f\"Skipping GL {gl_code}: insufficient annual observations.\")\n",
        "        continue\n",
        "\n",
        "    description = annual[\"description\"].iloc[-1]\n",
        "    years = annual[\"fy\"].tolist()\n",
        "    values = annual[\"total_amount\"].astype(float).to_numpy()\n",
        "\n",
        "    display(Markdown(f\"## GL {gl_code}: {description}\"))\n",
        "\n",
        "    # 1. Historical data plot.\n",
        "    display(Markdown(\"### Historical Data\"))\n",
        "    fig_hist = px.line(\n",
        "        annual,\n",
        "        x=\"fy\",\n",
        "        y=\"total_amount\",\n",
        "        markers=True,\n",
        "        title=f\"GL {gl_code} - {description}: Historical Minor Revenue\",\n",
        "        labels={\"fy\": \"Fiscal Year\", \"total_amount\": \"Total Amount\"},\n",
        "    )\n",
        "    fig_hist.update_layout(height=450)\n",
        "    fig_hist.show()\n",
        "\n",
        "    # 2. ACF and PACF plots with approximate 95% confidence intervals.\n",
        "    display(Markdown(\"### ACF and PACF With Confidence Intervals\"))\n",
        "    plot_acf_pacf_interactive(values, gl_code, description).show()\n",
        "\n",
        "    # 3. Unit-root tests for level and first difference.\n",
        "    display(Markdown(\"### Unit Root Tests\"))\n",
        "    unit_root_table = pd.DataFrame([\n",
        "        run_adf(values, \"Level\"),\n",
        "        run_adf(pd.Series(values).diff().dropna(), \"First difference\"),\n",
        "    ])\n",
        "    unit_root_table.insert(0, \"GL Number\", gl_code)\n",
        "    unit_root_table.insert(1, \"description\", description)\n",
        "    all_unit_root_tests.append(unit_root_table)\n",
        "    display(unit_root_table)\n",
        "\n",
        "    # 4. ARIMA/SARIMA lag-order search.\n",
        "    display(Markdown(\"### Lag Order Table\"))\n",
        "    d = select_d(unit_root_table)\n",
        "    best_order, order_table = find_arima_order(values, d=d, max_p=3, max_q=3)\n",
        "    order_table.insert(0, \"GL Number\", gl_code)\n",
        "    order_table.insert(1, \"description\", description)\n",
        "    all_order_tables.append(order_table)\n",
        "    display(order_table.head(10))\n",
        "\n",
        "    # 5. Regression/model results.\n",
        "    display(Markdown(\"### Regression and Model Results\"))\n",
        "\n",
        "    # Linear regression result: useful benchmark trend model.\n",
        "    linear_model = LinearRegression()\n",
        "    linear_model.fit(np.asarray(years).reshape(-1, 1), values)\n",
        "    linear_fitted = linear_model.predict(np.asarray(years).reshape(-1, 1))\n",
        "    ss_res = np.sum((values - linear_fitted) ** 2)\n",
        "    ss_tot = np.sum((values - values.mean()) ** 2)\n",
        "    linear_r2 = 1 - ss_res / ss_tot if ss_tot else np.nan\n",
        "    linear_model_result = pd.DataFrame([\n",
        "        {\n",
        "            \"GL Number\": gl_code,\n",
        "            \"description\": description,\n",
        "            \"model\": \"Linear regression\",\n",
        "            \"intercept\": linear_model.intercept_,\n",
        "            \"fy_coefficient\": linear_model.coef_[0],\n",
        "            \"r_squared\": linear_r2,\n",
        "        }\n",
        "    ])\n",
        "    all_linear_model_results.append(linear_model_result)\n",
        "    display(linear_model_result)\n",
        "\n",
        "    # Selected ARIMA/SARIMA model result summary.\n",
        "    arima_forecast_values, arima_result = forecast_arima(values, FORECAST_HORIZON, best_order)\n",
        "    display(HTML(arima_result.summary().as_html()))\n",
        "\n",
        "    # 6. Normality and autocorrelation tests on selected ARIMA residuals.\n",
        "    display(Markdown(\"### Normality and Autocorrelation Tests\"))\n",
        "    lb_lag = max(1, min(10, len(values) // 2 - 1))\n",
        "    lb = acorr_ljungbox(arima_result.resid, lags=[lb_lag], return_df=True)\n",
        "    jb_stat, jb_p = jarque_bera(arima_result.resid)\n",
        "    residual_tests = pd.DataFrame([\n",
        "        {\n",
        "            \"GL Number\": gl_code,\n",
        "            \"description\": description,\n",
        "            \"test\": \"Ljung-Box residual autocorrelation\",\n",
        "            \"lag\": lb_lag,\n",
        "            \"statistic\": float(lb[\"lb_stat\"].iloc[0]),\n",
        "            \"p_value\": float(lb[\"lb_pvalue\"].iloc[0]),\n",
        "            \"verdict\": \"No residual autocorrelation at 5%\" if float(lb[\"lb_pvalue\"].iloc[0]) > 0.05 else \"Residual autocorrelation may remain\",\n",
        "        },\n",
        "        {\n",
        "            \"GL Number\": gl_code,\n",
        "            \"description\": description,\n",
        "            \"test\": \"Jarque-Bera residual normality\",\n",
        "            \"lag\": np.nan,\n",
        "            \"statistic\": float(jb_stat),\n",
        "            \"p_value\": float(jb_p),\n",
        "            \"verdict\": \"Normality not rejected at 5%\" if float(jb_p) > 0.05 else \"Normality rejected at 5%\",\n",
        "        },\n",
        "    ])\n",
        "    all_residual_tests.append(residual_tests)\n",
        "    display(residual_tests)\n",
        "\n",
        "    # 7. Forecasted values for the next three fiscal years.\n",
        "    display(Markdown(\"### Forecasted Values\"))\n",
        "    forecast_table = forecast_all_models(years, values, best_order, horizon=FORECAST_HORIZON)\n",
        "    forecast_table.insert(0, \"GL Number\", gl_code)\n",
        "    forecast_table.insert(1, \"description\", description)\n",
        "    all_forecasts.append(forecast_table)\n",
        "    forecast_display = forecast_table[[\"GL Number\", \"description\", \"model\", \"fy\", \"forecast_amount\"]].copy()\n",
        "    display(forecast_display)\n",
        "\n",
        "    # 8. Model validation report table.\n",
        "    display(Markdown(\"### Model Validation Report\"))\n",
        "    validation_table = validate_models(years, values, best_order)\n",
        "    validation_table.insert(0, \"GL Number\", gl_code)\n",
        "    validation_table.insert(1, \"description\", description)\n",
        "    validation_table.insert(2, \"selected_arima_order\", str(best_order))\n",
        "    all_validation_tables.append(validation_table)\n",
        "    display(validation_table)\n",
        "\n",
        "    # 9. Historical and forecasted values plot for every model.\n",
        "    display(Markdown(\"### Historical and Forecasted Values Plot\"))\n",
        "    fig_all_models = go.Figure()\n",
        "    fig_all_models.add_trace(go.Scatter(x=years, y=values, mode=\"lines+markers\", name=\"Historical\"))\n",
        "    for model_name, model_forecast in forecast_table.groupby(\"model\"):\n",
        "        fig_all_models.add_trace(go.Scatter(\n",
        "            x=[years[-1], *model_forecast[\"fy\"].tolist()],\n",
        "            y=[values[-1], *model_forecast[\"forecast_amount\"].tolist()],\n",
        "            mode=\"lines+markers\",\n",
        "            line={\"dash\": \"dash\"},\n",
        "            name=model_name,\n",
        "        ))\n",
        "    fig_all_models.update_layout(\n",
        "        title=f\"GL {gl_code} - {description}: Historical and Forecasted Revenue\",\n",
        "        xaxis_title=\"Fiscal Year\",\n",
        "        yaxis_title=\"Amount\",\n",
        "        height=550,\n",
        "    )\n",
        "    fig_all_models.show()\n",
        "\n",
        "    # 10. Best model plot based on validation MAE.\n",
        "    display(Markdown(\"### Best Model Plot\"))\n",
        "    best_model = validation_table.iloc[0][\"model\"]\n",
        "    best_forecast = forecast_table[forecast_table[\"model\"].eq(best_model)].copy()\n",
        "    best_forecast[\"best_model\"] = best_model\n",
        "    all_best_model_forecasts.append(best_forecast)\n",
        "\n",
        "    fig_best = go.Figure()\n",
        "    fig_best.add_trace(go.Scatter(x=years, y=values, mode=\"lines+markers\", name=\"Historical\"))\n",
        "    fig_best.add_trace(go.Scatter(\n",
        "        x=[years[-1], *best_forecast[\"fy\"].tolist()],\n",
        "        y=[values[-1], *best_forecast[\"forecast_amount\"].tolist()],\n",
        "        mode=\"lines+markers\",\n",
        "        line={\"dash\": \"dash\"},\n",
        "        name=f\"Best validation model: {best_model}\",\n",
        "    ))\n",
        "    fig_best.update_layout(\n",
        "        title=f\"GL {gl_code} - {description}: Best Model Forecast\",\n",
        "        xaxis_title=\"Fiscal Year\",\n",
        "        yaxis_title=\"Amount\",\n",
        "        height=500,\n",
        "    )\n",
        "    fig_best.show()"
      ],
      "id": "e92952cd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Appendix\n",
        "\n",
        "## Consolidated Tables and Saved Outputs"
      ],
      "id": "9f1dbbae"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "unit_root_results = pd.concat(all_unit_root_tests, ignore_index=True) if all_unit_root_tests else pd.DataFrame()\n",
        "order_results = pd.concat(all_order_tables, ignore_index=True) if all_order_tables else pd.DataFrame()\n",
        "residual_test_results = pd.concat(all_residual_tests, ignore_index=True) if all_residual_tests else pd.DataFrame()\n",
        "linear_model_results = pd.concat(all_linear_model_results, ignore_index=True) if all_linear_model_results else pd.DataFrame()\n",
        "validation_results = pd.concat(all_validation_tables, ignore_index=True) if all_validation_tables else pd.DataFrame()\n",
        "forecast_results = pd.concat(all_forecasts, ignore_index=True) if all_forecasts else pd.DataFrame()\n",
        "best_model_forecasts = pd.concat(all_best_model_forecasts, ignore_index=True) if all_best_model_forecasts else pd.DataFrame()\n",
        "\n",
        "unit_root_results.to_csv(RESULTS_DIR / \"top_minor_unit_root_tests.csv\", index=False)\n",
        "order_results.to_csv(RESULTS_DIR / \"top_minor_arima_order_search.csv\", index=False)\n",
        "residual_test_results.to_csv(RESULTS_DIR / \"top_minor_residual_tests.csv\", index=False)\n",
        "linear_model_results.to_csv(RESULTS_DIR / \"top_minor_linear_model_results.csv\", index=False)\n",
        "validation_results.to_csv(RESULTS_DIR / \"top_minor_model_validation.csv\", index=False)\n",
        "forecast_results.to_csv(RESULTS_DIR / \"top_minor_all_model_forecasts.csv\", index=False)\n",
        "best_model_forecasts.to_csv(RESULTS_DIR / \"top_minor_best_model_forecasts.csv\", index=False)\n",
        "\n",
        "print(\"Saved output files to:\", RESULTS_DIR)"
      ],
      "id": "502692fa",
      "execution_count": null,
      "outputs": []
    },
